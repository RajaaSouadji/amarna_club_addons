<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Chevaux ================= -->
    <record id="view_club_horse_tree" model="ir.ui.view">
        <field name="name">amarna.club.horse.tree</field>
        <field name="model">amarna.club.horse</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="box_id"/>
                <field name="breed"/>
                <field name="age"/>
                <field name="owner_id" optional="hide"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'resting'"
                       decoration-danger="status == 'injured'"/>
                <field name="fatigue_pct" widget="progressbar"/>
                <field name="next_vet_visit"/>
                <field name="farrier_due"/>
                <field name="deworming_due"/>
            </list>
        </field>
    </record>

    <record id="view_club_horse_kanban" model="ir.ui.view">
        <field name="name">amarna.club.horse.kanban</field>
        <field name="model">amarna.club.horse</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <field name="image_1920" widget="image" options="{'img_class': 'rounded'}"
                                   class="o_kanban_image_fill_left" style="max-width: 72px;"/>
                            <div class="flex-grow-1">
                                <field name="name" class="fw-bold fs-5"/>
                                <field name="breed" class="text-muted d-block"/>
                                <field name="box_id" class="small"/>
                            </div>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'available'"
                                   decoration-warning="status == 'resting'"
                                   decoration-danger="status == 'injured'"/>
                        </div>
                        <field name="fatigue_pct" widget="progressbar"/>
                        <footer>
                            <span t-if="record.farrier_due.raw_value" class="badge text-bg-warning">Ferrage</span>
                            <span t-if="record.deworming_due.raw_value" class="badge text-bg-warning">Vermifuge</span>
                            <span t-if="record.is_boarder.raw_value" class="badge text-bg-info ms-auto">Pension</span>
                            <field name="farrier_due" invisible="1"/>
                            <field name="deworming_due" invisible="1"/>
                            <field name="is_boarder" invisible="1"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_club_horse_form" model="ir.ui.view">
        <field name="name">amarna.club.horse.form</field>
        <field name="model">amarna.club.horse</field>
        <field name="arch" type="xml">
            <form string="Cheval">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="available,resting,injured"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_care" type="object" class="oe_stat_button"
                                icon="fa-medkit">
                            <field name="care_count" widget="statinfo" string="Soins"/>
                        </button>
                        <button name="action_view_boarding" type="object" class="oe_stat_button"
                                icon="fa-handshake-o" invisible="not is_boarder and not boarding_count">
                            <field name="boarding_count" widget="statinfo" string="Pensions"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du cheval"/></h1>
                    </div>
                    <group>
                        <group string="Identité">
                            <field name="code"/>
                            <field name="breed"/>
                            <field name="sex"/>
                            <field name="coat"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="birth_date"/>
                            <field name="height_cm"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Hébergement">
                            <field name="box_id"/>
                            <field name="box_number" invisible="box_id"/>
                            <field name="owner_id"/>
                            <field name="is_boarder"/>
                            <field name="fatigue" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Santé" name="health">
                            <group>
                                <group string="Dernières dates">
                                    <field name="last_farrier"/>
                                    <field name="farrier_due"/>
                                    <field name="last_vaccine"/>
                                    <field name="last_deworming"/>
                                    <field name="deworming_due"/>
                                </group>
                                <group string="Suivi vétérinaire">
                                    <field name="next_vet_visit"/>
                                    <field name="vet_note"/>
                                    <field name="care_cost_total"/>
                                </group>
                            </group>
                            <field name="care_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="care_type"/>
                                    <field name="description"/>
                                    <field name="provider_id"/>
                                    <field name="cost" sum="Total"/>
                                    <field name="next_due"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alimentation" name="feed">
                            <group><field name="diet"/></group>
                            <field name="feed_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="meal"/>
                                    <field name="feed_name"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Identification" name="ids">
                            <group>
                                <field name="chip_number"/>
                                <field name="passport_number"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_club_horse_search" model="ir.ui.view">
        <field name="name">amarna.club.horse.search</field>
        <field name="model">amarna.club.horse</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="breed"/>
                <field name="owner_id"/>
                <field name="box_id"/>
                <field name="chip_number"/>
                <filter string="Disponibles" name="filter_available"
                        domain="[('status', '=', 'available')]"/>
                <filter string="Au repos" name="filter_resting"
                        domain="[('status', '=', 'resting')]"/>
                <filter string="Blessés" name="filter_injured"
                        domain="[('status', '=', 'injured')]"/>
                <separator/>
                <filter string="Ferrage à prévoir" name="filter_farrier"
                        domain="[('farrier_due', '=', True)]"/>
                <filter string="Vermifuge à prévoir" name="filter_deworming"
                        domain="[('deworming_due', '=', True)]"/>
                <separator/>
                <filter string="Pensionnaires" name="filter_boarders"
                        domain="[('is_boarder', '=', True)]"/>
                <filter string="Chevaux du club" name="filter_club"
                        domain="[('is_boarder', '=', False)]"/>
                <group>
                    <filter string="Statut" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Propriétaire" name="group_owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_club_horses" model="ir.actions.act_window">
        <field name="name">Chevaux</field>
        <field name="res_model">amarna.club.horse</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajoutez un cheval</p>
            <p>Chaque cheval a sa fiche : identité, box, ration, journal de soins et, pour les pensionnaires, son contrat.</p>
        </field>
    </record>

    <record id="action_club_horses_care_due" model="ir.actions.act_window">
        <field name="name">Soins à prévoir</field>
        <field name="res_model">amarna.club.horse</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('farrier_due', '=', True), ('deworming_due', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tous les soins sont à jour</p>
            <p>Les chevaux dont le ferrage ou le vermifuge dépasse l'intervalle défini dans les paramètres apparaissent ici.</p>
        </field>
    </record>

    <!-- ================= Journal des soins ================= -->
    <record id="view_club_horse_care_tree" model="ir.ui.view">
        <field name="name">amarna.club.horse.care.tree</field>
        <field name="model">amarna.club.horse.care</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="horse_id"/>
                <field name="care_type"/>
                <field name="description"/>
                <field name="provider_id"/>
                <field name="cost" sum="Total"/>
                <field name="next_due"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_club_horse_care_form" model="ir.ui.view">
        <field name="name">amarna.club.horse.care.form</field>
        <field name="model">amarna.club.horse.care</field>
        <field name="arch" type="xml">
            <form string="Soin">
                <sheet>
                    <group>
                        <group>
                            <field name="horse_id"/>
                            <field name="care_type"/>
                            <field name="date"/>
                            <field name="next_due"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="description"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observations, produit utilisé..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_club_horse_care_search" model="ir.ui.view">
        <field name="name">amarna.club.horse.care.search</field>
        <field name="model">amarna.club.horse.care</field>
        <field name="arch" type="xml">
            <search>
                <field name="horse_id"/>
                <field name="provider_id"/>
                <field name="description"/>
                <filter string="Maréchal-ferrant" name="filter_farrier" domain="[('care_type', '=', 'farrier')]"/>
                <filter string="Vaccins" name="filter_vaccine" domain="[('care_type', '=', 'vaccine')]"/>
                <filter string="Vermifuges" name="filter_deworming" domain="[('care_type', '=', 'deworming')]"/>
                <filter string="Vétérinaire" name="filter_vet" domain="[('care_type', '=', 'vet')]"/>
                <group>
                    <filter string="Cheval" name="group_horse" context="{'group_by': 'horse_id'}"/>
                    <filter string="Soin" name="group_type" context="{'group_by': 'care_type'}"/>
                    <filter string="Intervenant" name="group_provider" context="{'group_by': 'provider_id'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_club_horse_care_calendar" model="ir.ui.view">
        <field name="name">amarna.club.horse.care.calendar</field>
        <field name="model">amarna.club.horse.care</field>
        <field name="arch" type="xml">
            <calendar string="Soins" date_start="date" color="care_type" mode="month">
                <field name="horse_id"/>
                <field name="care_type"/>
            </calendar>
        </field>
    </record>

    <record id="action_club_horse_care" model="ir.actions.act_window">
        <field name="name">Journal des soins</field>
        <field name="res_model">amarna.club.horse.care</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun soin enregistré</p>
            <p>Notez chaque ferrage, vaccin, vermifuge ou visite vétérinaire : les dates de la fiche du cheval se mettent à jour toutes seules.</p>
        </field>
    </record>

    <!-- ================= Boxes & paddocks ================= -->
    <record id="view_club_horse_box_tree" model="ir.ui.view">
        <field name="name">amarna.club.horse.box.tree</field>
        <field name="model">amarna.club.horse.box</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="capacity"/>
                <field name="occupant_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'free'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'full'"/>
            </list>
        </field>
    </record>

    <record id="view_club_horse_box_form" model="ir.ui.view">
        <field name="name">amarna.club.horse.box.form</field>
        <field name="model">amarna.club.horse.box</field>
        <field name="arch" type="xml">
            <form string="Box / paddock">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ex. Box 12"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="occupant_count"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="horse_ids" readonly="1">
                        <list><field name="name"/><field name="status"/><field name="owner_id"/></list>
                    </field>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_club_horse_box_search" model="ir.ui.view">
        <field name="name">amarna.club.horse.box.search</field>
        <field name="model">amarna.club.horse.box</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Libres" name="filter_free" domain="[('state', '=', 'free')]"/>
                <filter string="Boxes" name="filter_box" domain="[('kind', '=', 'box')]"/>
                <filter string="Paddocks" name="filter_paddock" domain="[('kind', '=', 'paddock')]"/>
            </search>
        </field>
    </record>

    <record id="action_club_horse_box" model="ir.actions.act_window">
        <field name="name">Boxes &amp; paddocks</field>
        <field name="res_model">amarna.club.horse.box</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Contrats de pension ================= -->
    <record id="view_club_horse_boarding_tree" model="ir.ui.view">
        <field name="name">amarna.club.horse.boarding.tree</field>
        <field name="model">amarna.club.horse.boarding</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'ended'">
                <field name="name"/>
                <field name="horse_id"/>
                <field name="owner_id"/>
                <field name="box_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="monthly_fee"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_club_horse_boarding_form" model="ir.ui.view">
        <field name="name">amarna.club.horse.boarding.form</field>
        <field name="model">amarna.club.horse.boarding</field>
        <field name="arch" type="xml">
            <form string="Contrat de pension">
                <header>
                    <button name="action_start" type="object" string="Démarrer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_invoice_month" type="object" string="Facturer le mois"
                            class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_end" type="object" string="Terminer"
                            invisible="state != 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Factures"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="horse_id" readonly="state != 'draft'"/>
                            <field name="owner_id" readonly="state != 'draft'"/>
                            <field name="box_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="monthly_fee"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Conditions de la pension : soins inclus, ferrage, etc."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_club_horse_boarding" model="ir.actions.act_window">
        <field name="name">Contrats de pension</field>
        <field name="res_model">amarna.club.horse.boarding</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun contrat de pension</p>
            <p>Un propriétaire extérieur laisse son cheval à l'écurie ? Créez un contrat : box, tarif mensuel et facturation en un clic.</p>
        </field>
    </record>

    <!-- Settings entry of the stable -->
    <record id="action_ecurie_settings" model="ir.actions.act_window">
        <field name="name">Paramètres de l'écurie</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'amarna_club_ecurie'}</field>
    </record>

    <!-- ================= Menus : app « Écurie » ================= -->
    <menuitem id="menu_club_ecurie_root" web_icon="amarna_club_ecurie,static/description/icon.svg"
              name="Écurie"
              sequence="60"/>
    <!-- Qui voit cette application (rôles). Command.set remplace les groupes d'une version précédente. -->
    <record id="menu_club_ecurie_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.clear(), Command.link(ref('abonnement_amarna.group_club_coach'))]"/>
    </record>


    <menuitem id="menu_club_ecurie_horses" name="Chevaux"
              parent="menu_club_ecurie_root" sequence="10"/>
    <menuitem id="menu_club_horses" name="Tous les chevaux"
              parent="menu_club_ecurie_horses" action="action_club_horses" sequence="10"/>

    <menuitem id="menu_club_ecurie_health" name="Soins &amp; santé"
              parent="menu_club_ecurie_root" sequence="20"/>
    <menuitem id="menu_club_horse_care" name="Journal des soins"
              parent="menu_club_ecurie_health" action="action_club_horse_care" sequence="10"/>
    <menuitem id="menu_club_horses_care_due" name="Soins à prévoir"
              parent="menu_club_ecurie_health" action="action_club_horses_care_due" sequence="20"/>

    <menuitem id="menu_club_ecurie_housing" name="Boxes &amp; pensions"
              parent="menu_club_ecurie_root" sequence="30"/>
    <menuitem id="menu_club_horse_box" name="Boxes &amp; paddocks"
              parent="menu_club_ecurie_housing" action="action_club_horse_box" sequence="10"/>
    <menuitem id="menu_club_horse_boarding" name="Contrats de pension"
              parent="menu_club_ecurie_housing" action="action_club_horse_boarding" sequence="20"/>

    <menuitem id="menu_club_ecurie_config" name="Configuration"
              parent="menu_club_ecurie_root" sequence="90"
              groups="abonnement_amarna.group_club_manager"/>
    <menuitem id="menu_club_ecurie_settings" name="Paramètres de l'écurie"
              parent="menu_club_ecurie_config" action="action_ecurie_settings" sequence="10"
              groups="base.group_system"/>

</odoo>
