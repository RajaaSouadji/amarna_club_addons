<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_activity_tree" model="ir.ui.view">
        <field name="name">amarna.club.activity.tree</field>
        <field name="model">amarna.club.activity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="mobile_status" widget="badge"/>
                <field name="closure_start"/>
                <field name="closure_end"/>
                <field name="current_occupancy"/>
                <field name="max_capacity"/>
                <field name="occupancy_pct" widget="progressbar"/>
                <field name="assigned_staff" optional="show"/>
            </tree>
        </field>
    </record>
    <record id="view_club_activity_form" model="ir.ui.view">
        <field name="name">amarna.club.activity.form</field>
        <field name="model">amarna.club.activity</field>
        <field name="arch" type="xml">
            <form string="Activité">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'activité"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="icon_key"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Opérations">
                            <field name="mobile_status"/>
                            <field name="closure_start"/>
                            <field name="closure_end"/>
                            <field name="current_occupancy"/>
                            <field name="max_capacity"/>
                            <field name="occupancy_pct" widget="progressbar"/>
                            <field name="assigned_staff"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_club_activity_search" model="ir.ui.view">
        <field name="name">amarna.club.activity.search</field>
        <field name="model">amarna.club.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Ouvertes" name="filter_open" domain="[('mobile_status', '=', 'open')]"/>
                <filter string="Fermées / Maintenance" name="filter_closed" domain="[('mobile_status', 'in', ('closed', 'maintenance'))]"/>
            </search>
        </field>
    </record>
    <record id="action_club_activities" model="ir.actions.act_window">
        <field name="name">Activités</field>
        <field name="res_model">amarna.club.activity</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
