<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== -->
    <!-- TREE -->
    <!-- ===================== -->

    <record id="view_amarna_subscription_line_tree" model="ir.ui.view">
        <field name="name">amarna.subscription.line.tree</field>
        <field name="model">amarna.subscription.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="subscription_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="price_unit"/>
                <field name="price_subtotal"/>
            </tree>
        </field>
    </record>

    <!-- ===================== -->
    <!-- FORM -->
    <!-- ===================== -->

    <record id="view_amarna_subscription_line_form" model="ir.ui.view">
        <field name="name">amarna.subscription.line.form</field>
        <field name="model">amarna.subscription.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="subscription_id"/>
                        <field name="product_id"/>
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="price_subtotal" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== -->
    <!-- SEARCH -->
    <!-- ===================== -->

    <record id="view_amarna_subscription_line_search" model="ir.ui.view">
        <field name="name">amarna.subscription.line.search</field>
        <field name="model">amarna.subscription.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="subscription_id"/>
                <field name="product_id"/>
            </search>
        </field>
    </record>

    <!-- ===================== -->
    <!-- ACTION -->
    <!-- ===================== -->

    <record id="action_amarna_subscription_line" model="ir.actions.act_window">
        <field name="name">Lignes d'abonnement</field>
        <field name="res_model">amarna.subscription.line</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>