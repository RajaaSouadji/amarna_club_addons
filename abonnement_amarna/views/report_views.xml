<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- RAPPORT 1 : ANALYSE DES ABONNEMENTS -->
    <!-- ===================================================== -->

    <record id="view_amarna_subscription_pivot" model="ir.ui.view">
        <field name="name">amarna.subscription.pivot</field>
        <field name="model">amarna.subscription</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des abonnements" sample="1">
                <field name="activity_id" type="row"/>
                <field name="plan_id" type="row"/>
                <field name="subscription_status" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="payment_total" type="measure"/>
                <field name="payment_balance" type="measure"/>
                <field name="remaining_sessions" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_amarna_subscription_graph" model="ir.ui.view">
        <field name="name">amarna.subscription.graph</field>
        <field name="model">amarna.subscription</field>
        <field name="arch" type="xml">
            <graph string="Abonnements par activité" type="bar" sample="1">
                <field name="activity_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_amarna_subscription_report" model="ir.actions.act_window">
        <field name="name">Analyse des Abonnements</field>
        <field name="res_model">amarna.subscription</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune donnée d'abonnement à analyser.
            </p>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- RAPPORT 2 : RAPPORT DE FRÉQUENTATION & PRÉSENCE -->
    <!-- ===================================================== -->

    <record id="view_amarna_reservation_pivot" model="ir.ui.view">
        <field name="name">amarna.club.reservation.pivot</field>
        <field name="model">amarna.club.reservation</field>
        <field name="arch" type="xml">
            <pivot string="Analyse de la fréquentation" sample="1">
                <field name="activity_id" type="row"/>
                <field name="reservation_date" type="col" interval="month"/>
                <field name="people_count" type="measure"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_amarna_reservation_graph" model="ir.ui.view">
        <field name="name">amarna.club.reservation.graph</field>
        <field name="model">amarna.club.reservation</field>
        <field name="arch" type="xml">
            <graph string="Fréquentation par activité" type="bar" sample="1">
                <field name="activity_id"/>
                <field name="people_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_amarna_reservation_report" model="ir.actions.act_window">
        <field name="name">Rapport de Fréquentation &amp; Présence</field>
        <field name="res_model">amarna.club.reservation</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="domain">[('status_normalized', '=', 'checked_in')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune présence enregistrée à analyser.
            </p>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- RAPPORT 3 : RAPPORT DES REVENUS ET PAIEMENTS -->
    <!-- ===================================================== -->

    <record id="view_amarna_payment_pivot" model="ir.ui.view">
        <field name="name">amarna.subscription.payment.pivot</field>
        <field name="model">amarna.subscription.payment</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des revenus" sample="1">
                <field name="method" type="row"/>
                <field name="payment_date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_amarna_payment_graph" model="ir.ui.view">
        <field name="name">amarna.subscription.payment.graph</field>
        <field name="model">amarna.subscription.payment</field>
        <field name="arch" type="xml">
            <graph string="Revenus par mode de paiement" type="pie" sample="1">
                <field name="method"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_amarna_payment_report" model="ir.actions.act_window">
        <field name="name">Rapport des Revenus &amp; Encaissés</field>
        <field name="res_model">amarna.subscription.payment</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun paiement confirmé à analyser.
            </p>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- MENUS DES RAPPORTS -->
    <!-- ===================================================== -->

    <menuitem id="menu_amarna_subscription_report"
              name="Analyse des abonnements"
              parent="menu_amarna_analysis_root"
              action="action_amarna_subscription_report"
              sequence="1"/>

    <menuitem id="menu_amarna_reservation_report"
              name="Rapport de fréquentation"
              parent="menu_amarna_analysis_root"
              action="action_amarna_reservation_report"
              sequence="2"/>

    <menuitem id="menu_amarna_payment_report"
              name="Rapport des revenus"
              parent="menu_amarna_analysis_root"
              action="action_amarna_payment_report"
              sequence="3"/>

</odoo>
