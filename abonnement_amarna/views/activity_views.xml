<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- TREE VIEW -->
    <!-- ===================================================== -->

    <record id="view_amarna_activity_tree" model="ir.ui.view">
        <field name="name">amarna.activity.tree</field>
        <field name="model">amarna.activity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="subscription_plan_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- FORM VIEW -->
    <!-- ===================================================== -->

    <record id="view_amarna_activity_form" model="ir.ui.view">
        <field name="name">amarna.activity.form</field>
        <field name="model">amarna.activity</field>
        <field name="arch" type="xml">

            <form string="Activité">

                <sheet>


                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_subscription_plans"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tags">

                            <field name="subscription_plan_count"
                                   widget="statinfo"
                                   string="Plans"/>

                        </button>

                    </div>

                      <field name="image_1920"
                                   widget="image"
                                   class="oe_avatar"
                                   nolabel="1"
                                   options="{'size':[200,200]}"/>


                    <!-- Titre -->

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name" class="oe_inline"
                                   placeholder="Nouvelle activité"/>
                        </h1>

                    </div>

                    <group>
                        <group >
                            <field name="code" class="oe_inline" placeholder="code"/>
                            <field name="active"/>
                        </group>


                    </group>

                    <!-- Notebook -->

                    <notebook>

                        <page string="Description">

                            <field name="description"
                                   nolabel="1"
                                   placeholder="Décrivez cette activité..."/>

                        </page>

                        <!--
                        Quand tu ajoutes :

                        note = fields.Html()

                        décommente cette page.

                        <page string="Notes internes">

                            <field name="note"/>

                        </page>
                        -->

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- SEARCH VIEW -->
    <!-- ===================================================== -->

    <record id="view_amarna_activity_search" model="ir.ui.view">
        <field name="name">amarna.activity.search</field>
        <field name="model">amarna.activity</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="code"/>

                <filter string="Activités actives"
                        name="active"
                        domain="[('active','=',True)]"/>

            </search>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- ACTION -->
    <!-- ===================================================== -->

    <record id="action_amarna_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">amarna.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_amarna_activity_search"/>
    </record>

    <!-- ===================================================== -->
    <!-- MENU -->
    <!-- ===================================================== -->

    <menuitem id="menu_amarna_activity"
              name="Activitiés"
              parent="menu_amarna_configuration_root"
              action="action_amarna_activity"
              sequence="4"/>

</odoo>