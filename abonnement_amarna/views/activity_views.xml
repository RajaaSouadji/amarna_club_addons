<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- INHERIT CLUB ACTIVITY FORM FOR SUBSCRIPTION PLANS SMART BUTTON -->
    <record id="view_club_activity_form_inherit_subscription" model="ir.ui.view">
        <field name="name">amarna.club.activity.form.inherit.subscription</field>
        <field name="model">amarna.club.activity</field>
        <field name="inherit_id" ref="amarna_club_base.view_club_activity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_subscription_plans"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tags">
                        <field name="subscription_plan_count"
                               widget="statinfo"
                               string="Plans"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_amarna_activity" model="ir.actions.act_window">
        <field name="name">Activités du club</field>
        <field name="res_model">amarna.club.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_amarna_activity"
              name="Activités du club"
              parent="menu_amarna_configuration_root"
              action="action_amarna_activity"
              sequence="4"/>

</odoo>