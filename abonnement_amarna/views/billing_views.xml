<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Toutes les factures émises pour les abonnements et les réservations du club.
         La comptabilité Odoo reste la source de vérité ; ces vues ne font que filtrer. -->
    <record id="view_amarna_invoice_tree" model="ir.ui.view">
        <field name="name">amarna.invoice.tree</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="payment_state in ('not_paid', 'partial')">
                <field name="name" string="Facture"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="amarna_subscription_id" string="Abonnement"/>
                <field name="amarna_reservation_id" string="Réservation"/>
                <field name="amount_total" sum="Total TTC"/>
                <field name="amount_residual" sum="Reste à payer"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_amarna_invoice_search" model="ir.ui.view">
        <field name="name">amarna.invoice.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Facture"/>
                <field name="partner_id"/>
                <field name="amarna_subscription_id"/>
                <field name="amarna_reservation_id"/>
                <field name="amarna_activity_id"/>
                <filter string="À encaisser" name="filter_open"
                        domain="[('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter string="Payées" name="filter_paid" domain="[('payment_state', '=', 'paid')]"/>
                <separator/>
                <filter string="Abonnements" name="filter_subs" domain="[('amarna_subscription_id', '!=', False)]"/>
                <filter string="Réservations" name="filter_resa" domain="[('amarna_reservation_id', '!=', False)]"/>
                <group>
                    <filter string="Activité" name="group_activity" context="{'group_by': 'amarna_activity_id'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'invoice_date:month'}"/>
                    <filter string="Statut de paiement" name="group_payment" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amarna_invoices" model="ir.actions.act_window">
        <field name="name">Factures du club</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_amarna_invoice_tree"/>
        <field name="search_view_id" ref="view_amarna_invoice_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'),
            '|', ('amarna_subscription_id', '!=', False), ('amarna_reservation_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune facture pour le moment</p>
            <p>Les factures des abonnements et des réservations apparaissent ici. Encaissez-les depuis la fiche de l'abonnement ou de la réservation.</p>
        </field>
    </record>

    <menuitem id="menu_amarna_invoices" name="Factures"
              parent="menu_amarna_billing_root" action="action_amarna_invoices" sequence="1"/>

</odoo>
