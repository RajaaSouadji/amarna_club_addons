<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amarna_rfid_card_tree" model="ir.ui.view">
        <field name="name">amarna.rfid.card.tree</field>
        <field name="model">amarna.rfid.card</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="assigned_date"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_amarna_rfid_card_form" model="ir.ui.view">
        <field name="name">amarna.rfid.card.form</field>
        <field name="model">amarna.rfid.card</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_scan" string="SCAN" type="object" class="oe_highlight"/>
                    <button name="action_activate" string="Activer" type="object" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_deactivate" string="Désactiver" type="object" invisible="state != 'active'"/>
                    <button name="action_block" string="Bloquer" type="object" invisible="state == 'blocked'"/>
                    <button name="action_unassign" string="Désattribuer" type="object" invisible="not partner_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,inactive,blocked"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="partner_id"/>
                        <field name="assigned_date"/>
                        <field name="active"/>
                        <field name="company_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_amarna_rfid_cards" model="ir.actions.act_window">
        <field name="name">Cartes RFID</field>
        <field name="res_model">amarna.rfid.card</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_amarna_rfid_cards"
              name="Cartes RFID"
              parent="menu_amarna_subscription_root"
              action="action_amarna_rfid_cards"
              sequence="2"/>
</odoo>
