<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- TREE VIEW -->
    <!-- ===================================================== -->

    <record id="view_amarna_recurring_plan_tree" model="ir.ui.view">
        <field name="name">amarna.recurring.plan.tree</field>
        <field name="model">amarna.recurring.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="duration_days"/>
                <field name="auto_close_limit"/>
                <field name="active"/>
            </tree>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- FORM VIEW -->
    <!-- ===================================================== -->

    <record id="view_amarna_recurring_plan_form" model="ir.ui.view">
        <field name="name">amarna.recurring.plan.form</field>
        <field name="model">amarna.recurring.plan</field>
        <field name="arch" type="xml">

            <form>

                <chatter/>

                <sheet>

                    <!-- SMART BUTTONS -->

                    <div class="oe_button_box" name="button_box">

                        <button class="oe_stat_button"
                                icon="fa-refresh"
                                type="object"
                                name="action_view_subscriptions">

                            <field name="subscription_count"
                                   widget="statinfo"
                                   string="Abonnements"/>

                        </button>

                        <button class="oe_stat_button"
                                icon="fa-list"
                                type="object"
                                name="action_view_lines">

                            <field name="line_count"
                                   widget="statinfo"
                                   string="Articles d'abonnement"/>

                        </button>

                    </div>

                    <!-- TITLE -->

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"
                                   placeholder="Nom du plan"/>
                        </h1>

                    </div>


                    <!-- DETAILS -->

                    <group>

                        <!-- LEFT -->

                        <group string="DÉTAILS">



                            <field name="duration_days"
                                   string="Nombre de jours"/>

                            <field name="auto_close_limit"
                                   string="Résiliation automatique"/>

                        </group>


                        <!-- RIGHT -->

                        <group string="SELF-SERVICE">

                            <field name="active"/>

                        </group>

                    </group>


                    <!-- NOTEBOOK -->

                    <notebook>

                        <page string="Tarification">

                            <field name="recurring_line_ids"
                                   mode="tree,form">

                                <!-- LISTE -->

                                <tree>

                                    <field name="product_id"/>

                                    <field name="price_unit"
                                           string="Prix fixe"/>

                                    <field name="validity_number"
                                           string="Validité"/>

                                    <field name="validity_unit_id"
                                           string="Unité"/>

                                </tree>


                                <!-- POPUP -->

                                <form string="Créer Pricing">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="product_id"/>
                                                <field name="price_unit"
                                                       string="Prix unitaire"/>
                                            </group>
                                            <group>
                                                <field name="plan_id"
                                                       readonly="1"/>

                                            </group>

                                        </group>

                                    </sheet>

                                </form>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- SEARCH VIEW -->
    <!-- ===================================================== -->

    <record id="view_amarna_recurring_plan_search" model="ir.ui.view">
        <field name="name">amarna.recurring.plan.search</field>
        <field name="model">amarna.recurring.plan</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="duration_days"/>

            </search>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- ACTION -->
    <!-- ===================================================== -->

    <record id="action_amarna_recurring_plan" model="ir.actions.act_window">

        <field name="name">Plans récurrents</field>

        <field name="res_model">amarna.recurring.plan</field>

        <field name="view_mode">tree,form</field>

        <field name="search_view_id"
               ref="view_amarna_recurring_plan_search"/>

    </record>


    <!-- ===================================================== -->
    <!-- MENU -->
    <!-- ===================================================== -->

    <menuitem id="menu_amarna_recurring_plan"
              name="Plans récurrents"
              parent="menu_amarna_configuration_root"
              action="action_amarna_recurring_plan"
              sequence="7"/>

</odoo>
