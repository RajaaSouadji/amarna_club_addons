<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- VUE DU WIZARD DE SCAN RFID -->
    <!-- ===================================================== -->

    <record id="view_amarna_scan_wizard_form" model="ir.ui.view">
        <field name="name">amarna.scan.wizard.form</field>
        <field name="model">amarna.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scanner une carte RFID">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>🔍 Contrôle d'accès — Scan RFID</h2>
                        <p class="text-muted">
                            Sélectionnez la carte RFID du membre à scanner puis cliquez sur <strong>Scanner</strong>.
                        </p>
                    </div>

                    <group>
                        <group string="Sélection de la carte" invisible="result_state == 'success'">
                            <field name="card_code" placeholder="Passez la carte ou saisissez le numéro, puis Entrée"
                                   default_focus="1" class="fs-4"/>
                            <field name="card_id" options="{'no_create': True, 'no_open': True}" invisible="not card_id"/>
                            <button name="action_scan"
                                    string="Scanner la carte"
                                    type="object"
                                    class="btn-primary mt-2"
                                    icon="fa-qrcode"
                                    invisible="not card_id"/>
                        </group>

                        <group string="Résultat de la vérification">
                            <field name="result_state"
                                   widget="badge"
                                   decoration-success="result_state in ('ok', 'success')"
                                   decoration-danger="result_state == 'denied'"/>
                            <field name="result_message" nolabel="1" colspan="2" class="text-wrap font-weight-bold" style="white-space: pre-line; font-size: 1.1em;"/>
                        </group>
                    </group>

                    <!-- Informations détaillées du membre affichées après scan (ok ou success) -->
                    <div invisible="result_state not in ('ok', 'success')" class="border rounded p-3 bg-light mt-3">
                        <div class="d-flex align-items-center mb-3">
                            <field name="partner_image" widget="image" class="oe_avatar me-3" style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%; border: 2px solid #007bff;"/>
                            <div>
                                <h3 class="m-0"><field name="partner_id" readonly="1" class="oe_inline"/></h3>
                                <div class="text-muted">
                                    <span invisible="not partner_phone">📞 <field name="partner_phone" readonly="1"/></span>
                                    <span class="ms-3" invisible="not partner_email">✉️ <field name="partner_email" readonly="1"/></span>
                                </div>
                            </div>
                        </div>

                        <notebook>
                            <page string="Abonnement &amp; Séances" name="sub_info">
                                <group col="2">
                                    <group string="Formule &amp; Validité">
                                        <field name="subscription_id" domain="[('id', 'in', subscription_ids)]"/>
                                        <field name="subscription_ids" nolabel="1" colspan="2">
                                            <tree create="0" delete="0">
                                                <field name="activity_id"/>
                                                <field name="plan_id"/>
                                                <field name="start_date"/>
                                                <field name="expiration_date"/>
                                                <field name="sessions_label"/>
                                                <field name="subscription_status" widget="badge"/>
                                            </tree>
                                        </field>
                                        <field name="plan_id" readonly="1"/>
                                        <field name="activity_id" readonly="1"/>
                                        <field name="subscription_type_id" readonly="1"/>
                                        <field name="subscription_status" widget="badge" decoration-success="subscription_status == 'active'" decoration-warning="subscription_status == 'unpaid'" decoration-danger="subscription_status in ('expired', 'cancelled')" readonly="1"/>
                                    </group>
                                    <group string="Séances &amp; Dates">
                                        <field name="start_date" readonly="1"/>
                                        <field name="expiration_date" readonly="1"/>
                                        <field name="sessions_label" class="fw-bold fs-5 text-primary" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Statut Financier" name="payment_info">
                                <group col="2">
                                    <group string="Paiements">
                                        <field name="currency_id" invisible="1"/>
                                        <field name="payment_valid" widget="boolean_toggle" readonly="1"/>
                                        <field name="payment_total" widget="monetary" readonly="1"/>
                                        <field name="payment_balance" widget="monetary" class="fw-bold" decoration-danger="payment_balance &gt; 0" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Badge RFID &amp; Historique" name="rfid_info">
                                <group col="2">
                                    <group string="Carte RFID">
                                        <field name="rfid_uid" readonly="1"/>
                                        <field name="card_state" widget="badge" decoration-success="card_state == 'active'" decoration-danger="card_state in ('blocked', 'lost')" readonly="1"/>
                                    </group>
                                    <group string="Historique">
                                        <field name="last_checkin_datetime" string="Dernier passage" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </div>

                </sheet>

                <footer>
                    <button name="action_do_checkin"
                            string="Valider le passage"
                            type="object"
                            class="btn-success"
                            icon="fa-check"
                            invisible="result_state != 'ok'"/>

                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- ACTION POUR OUVRIR LE WIZARD -->
    <!-- ===================================================== -->

    <record id="action_amarna_scan_wizard" model="ir.actions.act_window">
        <field name="name">Scanner une carte RFID</field>
        <field name="res_model">amarna.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_amarna_scan_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- ===================================================== -->
    <!-- MENU RACCOURCI DANS ABONNEMENTS & ACCÈS -->
    <!-- ===================================================== -->

    <menuitem id="menu_amarna_scan"
              name="Scanner une carte"
              parent="menu_amarna_subscription_root"
              action="action_amarna_scan_wizard"
              sequence="7"/>

</odoo>
