<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE -->
    <record id="view_amarna_subscription_plan_tree" model="ir.ui.view">
        <field name="name">amarna.subscription.plan.tree</field>
        <field name="model">amarna.subscription.plan</field>
        <field name="arch" type="xml">

            <tree>

                <field name="name"/>

                <field name="activity_id" string="Activité concernée"/>

                <field name="subscription_type_id" string="Type abonnement"/>

                <field name="duration_days" string="Durée (jours)"/>

                <field name="session_count" string="Séances incluses"/>

                <field name="list_price"/>

                <field name="active"/>

            </tree>

        </field>
    </record>

    <!-- FORM -->
    <record id="view_amarna_subscription_plan_form" model="ir.ui.view">
        <field name="name">amarna.subscription.plan.form</field>
        <field name="model">amarna.subscription.plan</field>

        <field name="arch" type="xml">

            <form string="Formule abonnement">

                <sheet>

                    <!-- Smart Buttons -->

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_product"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cube">

                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    Product
                                </span>
                            </div>

                        </button>

                        <button name="action_view_subscriptions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="subscription_count"
                                   widget="statinfo"
                                   string="Abonnements"/>

                        </button>

                    </div>

                    <!-- Image -->

                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"
                           nolabel="1"/>

                    <!-- Title -->

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field name="name"
                                   placeholder="New Subscription Plan"/>

                        </h1>

                    </div>

                    <!-- Main Information -->

                    <group>

                        <group string="General">
                            <field name="activity_id" string="Activité concernée"/>
                            <field name="subscription_type_id" string="Type abonnement"/>
                            <field name="duration_days" string="Durée (jours)"/>
                            <field name="session_count" string="Séances incluses"/>
                        </group>

                        <group string="Product">
                            <field name="product_id" string="Produit de facturation"/>
                            <field name="list_price"
                                   readonly="1"/>
                            <field name="active"/>
                        </group>

                    </group>

                    <!-- Notebook -->

                    <notebook>

                        <page string="Description">

                            <field name="description"
                                   nolabel="1"/>

                        </page>

<!--                        <page string="Internal Notes">-->

<!--                            <field name="note"-->
<!--                                   nolabel="1"/>-->

<!--                        </page>-->

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <record id="view_amarna_subscription_plan_search" model="ir.ui.view">
        <field name="name">amarna.subscription.plan.search</field>
        <field name="model">amarna.subscription.plan</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="activity_id" string="Activité concernée"/>

                <field name="subscription_type_id" string="Type abonnement"/>

                <field name="product_id" string="Produit de facturation"/>

                <filter string="Active"
                        name="active"
                        domain="[('active','=',True)]"/>

            </search>

        </field>
    </record>

    <!-- ACTION -->
    <record id="action_amarna_subscription_plan" model="ir.actions.act_window">
        <field name="name">Formules abonnement</field>
        <field name="res_model">amarna.subscription.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_amarna_subscription_plan"
              name="Plans d'abonnement"
              parent="menu_amarna_product_root"
              action="action_amarna_subscription_plan"
              sequence="2"/>

</odoo>


