<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Core app "Abonnements". Each optional module (reservations, equipment,
        maintenance, stock, stable, pool, staff) is its own app with its own
        top-level menu and Configuration section, as in standard Odoo.
    -->
    <menuitem id="menu_amarna_root" web_icon="abonnement_amarna,static/description/icon.svg" name="Abonnements" sequence="10"/>
    <!-- Qui voit cette application (rôles). Command.set remplace les groupes d'une version précédente. -->
    <record id="menu_amarna_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.clear(), Command.link(ref('abonnement_amarna.group_club_reception')), Command.link(ref('abonnement_amarna.group_club_coach'))]"/>
    </record>


    <menuitem id="menu_amarna_subscription_root" name="Membres et accès"
              parent="menu_amarna_root" sequence="20"/>

    <!-- Pas de menu Facturation ici : les factures du club se trouvent dans l'application
         Facturation d'Odoo (Clients > Factures du club). -->

    <!-- Catalogue : activités, formules et durées -->
    <menuitem id="menu_amarna_product_root" name="Catalogue"
              parent="menu_amarna_root" sequence="70"/>

    <!-- Configuration du club -->
    <menuitem id="menu_amarna_configuration_root" name="Configuration"
              parent="menu_amarna_root" sequence="90"/>

</odoo>
