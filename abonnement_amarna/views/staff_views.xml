<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amarna_club_staff_tree" model="ir.ui.view">
        <field name="name">amarna.club.staff.tree</field>
        <field name="model">amarna.club.staff</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
                <field name="phone"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_amarna_club_staff_form" model="ir.ui.view">
        <field name="name">amarna.club.staff.form</field>
        <field name="model">amarna.club.staff</field>
        <field name="arch" type="xml">
            <form string="Membre du personnel">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Prénom Nom"/></h1>
                    </div>
                    <group>
                        <field name="role"/>
                        <field name="phone"/>
                        <field name="user_id"/>
                        <field name="activity_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_amarna_club_staff" model="ir.actions.act_window">
        <field name="name">Personnel du club</field>
        <field name="res_model">amarna.club.staff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajoutez le personnel du club</p>
            <p>Les techniciens et soigneurs proposés sur la tablette viennent de cette liste.</p>
        </field>
    </record>

    <menuitem id="menu_amarna_club_staff" name="Personnel du club"
              parent="menu_amarna_configuration_root" action="action_amarna_club_staff" sequence="10"/>

</odoo>
