<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amarna_subscription_tree" model="ir.ui.view">
        <field name="name">amarna.subscription.tree</field>
        <field name="model">amarna.subscription</field>
        <field name="arch" type="xml">
            <list decoration-muted="subscription_status == 'cancelled'"
                  decoration-danger="subscription_status in ('unpaid', 'expired')"
                  decoration-success="subscription_status == 'active'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="activity_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiration_date"/>
                <field name="sessions_label" optional="show"/>
                <field name="amount_total" sum="Total TTC"/>
                <field name="amount_due" sum="Reste à payer"/>
                <field name="subscription_status" widget="badge"
                       decoration-success="subscription_status == 'active'"
                       decoration-danger="subscription_status in ('unpaid', 'expired')"
                       decoration-info="subscription_status == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_amarna_subscription_form" model="ir.ui.view">
        <field name="name">amarna.subscription.form</field>
        <field name="model">amarna.subscription</field>
        <field name="arch" type="xml">
            <form string="Abonnement">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_collect" string="Encaisser" type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed' or billing_state not in ('to_invoice', 'unpaid', 'partial')"
                            help="Facture la période si besoin, puis ouvre l'encaissement (espèces, chèque, carte)."/>
                    <button name="action_create_invoice" string="Facturer sans encaisser" type="object"
                            invisible="state != 'confirmed' or billing_state != 'to_invoice'"/>
                    <button name="action_renew" string="Renouveler" type="object"
                            invisible="state != 'confirmed'"
                            confirm="Démarrer la période suivante et émettre sa facture ?"/>
                    <button name="action_cancel" string="Annuler l'abonnement" type="object"
                            invisible="state != 'confirmed'"
                            confirm="Annuler cet abonnement ? L'accès RFID sera coupé."/>
                    <button name="action_draft" string="Remettre en brouillon" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Factures"/>
                        </button>
                        <button name="action_view_checkins" type="object" class="oe_stat_button" icon="fa-id-card-o">
                            <field name="checkin_count" widget="statinfo" string="Passages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Abonnement">
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="plan_id" options="{'no_create': True}"/>
                            <field name="activity_id"/>
                            <field name="start_date"/>
                            <field name="rfid_card_id" domain="[('partner_id', '=', partner_id)]"
                                   context="{'default_partner_id': partner_id}"
                                   placeholder="Rempli avec la carte du membre"
                                   options="{'no_create_edit': True}"/>
                            <field name="auto_renew"/>
                        </group>
                        <group string="Période">
                            <field name="expiration_date"/>
                            <field name="is_unlimited" invisible="1"/>
                            <field name="remaining_sessions" invisible="is_unlimited"/>
                        </group>
                    </group>
                    <group string="Paiement" invisible="state == 'draft'">
                        <group>
                            <field name="billing_period_start" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                        </group>
                        <group>
                            <field name="amount_due" class="fw-bold"/>
                            <field name="billing_state" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_qty" string="Qté"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="name" optional="hide"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="price_subtotal" sum="Total HT"/>
                                </list>
                            </field>
                        </page>
                        <page string="Avancé" name="advanced" groups="abonnement_amarna.group_club_manager">
                            <group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="payment_required"/>
                                </group>
                                <group>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_invoiced"/>
                                    <field name="payment_valid" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Factures" name="invoices" invisible="state == 'draft'">
                            <field name="invoice_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="amarna_period_start"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="amount_residual" sum="Reste"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historique des périodes" name="history" invisible="state == 'draft'">
                            <field name="history_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="start_date"/>
                                    <field name="expiration_date"/>
                                    <field name="reason"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_amarna_subscription_search" model="ir.ui.view">
        <field name="name">amarna.subscription.search</field>
        <field name="model">amarna.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="activity_id"/>
                <filter string="Actifs" name="filter_active"
                        domain="[('subscription_status', '=', 'active')]"/>
                <filter string="Impayés" name="filter_unpaid"
                        domain="[('state', '=', 'confirmed'), ('billing_state', 'in', ('to_invoice', 'unpaid', 'partial'))]"/>
                <filter string="Expirés" name="filter_expired"
                        domain="[('subscription_status', '=', 'expired')]"/>
                <separator/>
                <filter string="Renouvellement auto" name="filter_auto" domain="[('auto_renew', '=', True)]"/>
                <group>
                    <filter string="Activité" name="group_activity" context="{'group_by': 'activity_id'}"/>
                    <filter string="Formule" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Statut" name="group_status" context="{'group_by': 'subscription_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amarna_subscription" model="ir.actions.act_window">
        <field name="name">Abonnements</field>
        <field name="res_model">amarna.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amarna_subscription_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un abonnement</p>
            <p>Un abonnement relie un membre à une formule. Confirmez-le, facturez la période puis encaissez.</p>
        </field>
    </record>

    <menuitem id="menu_amarna_subscription" name="Abonnements"
              parent="menu_amarna_subscription_root" action="action_amarna_subscription" sequence="1"/>

</odoo>
