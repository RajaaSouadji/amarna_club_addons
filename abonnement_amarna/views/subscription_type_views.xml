<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amarna_subscription_type_tree" model="ir.ui.view">
        <field name="name">amarna.subscription.type.tree</field>
        <field name="model">amarna.subscription.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="duration_summary"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_amarna_subscription_type_form" model="ir.ui.view">
        <field name="name">amarna.subscription.type.form</field>
        <field name="model">amarna.subscription.type</field>
        <field name="arch" type="xml">
            <form string="Durée d'abonnement">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex. Mensuel, Trimestriel, Annuel"/></h1>
                    </div>
                    <group>
                        <field name="duration_value"/>
                        <field name="duration_unit"/>
                        <field name="duration_summary" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amarna_subscription_type_search" model="ir.ui.view">
        <field name="name">amarna.subscription.type.search</field>
        <field name="model">amarna.subscription.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archivées" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_amarna_subscription_type" model="ir.actions.act_window">
        <field name="name">Durées d'abonnement</field>
        <field name="res_model">amarna.subscription.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_amarna_subscription_type_search"/>
    </record>

    <menuitem id="menu_amarna_subscription_type" name="Durées"
              parent="menu_amarna_product_root" action="action_amarna_subscription_type" sequence="2"/>

</odoo>
