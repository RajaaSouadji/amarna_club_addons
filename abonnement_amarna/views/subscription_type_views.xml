<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amarna_subscription_type_tree" model="ir.ui.view">
        <field name="name">amarna.subscription.type.tree</field>
        <field name="model">amarna.subscription.type</field>
        <field name="arch" type="xml">
            <tree string="Types d'abonnement" decoration-muted="not active">
                <field name="name" string="Type"/>
                <field name="duration_value" string="Durée"/>
                <field name="duration_unit" string="Unité"/>
                <field name="duration_days" string="Jours"/>
                <field name="duration_summary" string="Résumé"/>
                <field name="active" string="Actif" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_amarna_subscription_type_form" model="ir.ui.view">
        <field name="name">amarna.subscription.type.form</field>
        <field name="model">amarna.subscription.type</field>
        <field name="arch" type="xml">
            <form string="Type d'abonnement">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom du type"/>
                        <h1>
                            <field name="name" placeholder="Ex. Mensuel, Annuel, Vacances..."/>
                        </h1>
                    </div>

                    <group col="2">
                        <group string="Durée du type">
                            <field name="duration_value" string="Nombre"/>
                            <field name="duration_unit" string="Unité"/>
                            <div class="text-muted" colspan="2">
                                Exemple : 1 Mois correspond automatiquement à 30 jours.
                            </div>
                        </group>
                        <group string="Résultat">
                            <field name="duration_days" string="Durée calculée (jours)" readonly="1"/>
                            <field name="duration_summary" string="Résumé" readonly="1"/>
                            <field name="active" string="Type actif" widget="boolean_toggle"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amarna_subscription_type_search" model="ir.ui.view">
        <field name="name">amarna.subscription.type.search</field>
        <field name="model">amarna.subscription.type</field>
        <field name="arch" type="xml">
            <search string="Rechercher un type">
                <field name="name" string="Type"/>
                <field name="duration_unit" string="Unité"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_amarna_subscription_type" model="ir.actions.act_window">
        <field name="name">Types d'abonnement</field>
        <field name="res_model">amarna.subscription.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_amarna_subscription_type_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_amarna_subscription_type"
              name="Types d'abonnement"
              parent="menu_amarna_configuration_root"
              action="action_amarna_subscription_type"
              sequence="2"/>

</odoo>
