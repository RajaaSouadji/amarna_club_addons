<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function model="amarna.club.activity" name="_prepare_default_activity_xmlids"/>

    <!-- Structure only: name, code, icon and dedicated tablet screen. Capacity,
         occupancy, staff and prices are set by the club in Odoo; sample values
         are in demo/activity_demo.xml. -->
    <data noupdate="1">

        <record id="activity_pool" model="amarna.club.activity">
            <field name="name">Piscine</field>
            <field name="code">pool</field>
            <field name="icon_key">pool</field>
            <field name="mobile_screen">pool</field>
            <field name="mobile_screen_label">Relevés de qualité de l'eau</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_horses" model="amarna.club.activity">
            <field name="name">Équitation</field>
            <field name="code">horses</field>
            <field name="icon_key">horses</field>
            <field name="mobile_screen">horses</field>
            <field name="mobile_screen_label">Écurie : chevaux et soins</field>
            <field name="sequence">20</field>
        </record>

        <record id="activity_shooting" model="amarna.club.activity">
            <field name="name">Stand de Tir</field>
            <field name="code">shooting</field>
            <field name="icon_key">shooting</field>
            <field name="mobile_screen">armory</field>
            <field name="mobile_screen_label">Armurerie et nettoyage</field>
            <field name="sequence">30</field>
        </record>

        <record id="activity_paintball" model="amarna.club.activity">
            <field name="name">Paintball</field>
            <field name="code">paintball</field>
            <field name="icon_key">paintball</field>
            <field name="mobile_screen">paintball</field>
            <field name="mobile_screen_label">Terrain et sessions</field>
            <field name="sequence">40</field>
        </record>

        <record id="activity_gym" model="amarna.club.activity">
            <field name="name">Salle de Gym</field>
            <field name="code">gym</field>
            <field name="icon_key">gym</field>
            <field name="mobile_screen">gym</field>
            <field name="mobile_screen_label">Machines de la salle</field>
            <field name="sequence">50</field>
        </record>

        <record id="activity_padel" model="amarna.club.activity">
            <field name="name">Terrains de Padel</field>
            <field name="code">padel</field>
            <field name="icon_key">padel</field>
            <field name="mobile_screen">padel</field>
            <field name="mobile_screen_label">Terrains et réservations</field>
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
