<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_intervention_tree" model="ir.ui.view">
        <field name="name">amarna.club.intervention.tree</field>
        <field name="model">amarna.club.intervention</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue"
                  decoration-muted="status == 'resolved'">
                <field name="create_date" string="Créé le"/>
                <field name="name"/>
                <field name="type"/>
                <field name="activity_id"/>
                <field name="asset_id" optional="show"/>
                <field name="priority"
                       widget="badge"
                       decoration-danger="priority == 'critical'"
                       decoration-warning="priority == 'high'"
                       decoration-info="priority == 'medium'"/>
                <field name="status"
                       widget="badge"
                       decoration-warning="status == 'open'"
                       decoration-info="status == 'inProgress'"
                       decoration-success="status == 'resolved'"/>
                <field name="date_due"/>
                <field name="is_overdue" optional="hide"/>
                <field name="staff_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_club_intervention_form" model="ir.ui.view">
        <field name="name">amarna.club.intervention.form</field>
        <field name="model">amarna.club.intervention</field>
        <field name="arch" type="xml">
            <form string="Intervention">
                <header>
                    <button name="action_take_over" string="Prendre en charge"
                            type="object" class="oe_highlight"
                            invisible="status != 'open'"/>
                    <button name="action_resolve" string="Clôturer"
                            type="object" class="oe_highlight"
                            invisible="status != 'inProgress'"/>
                    <button name="action_reopen" string="Rouvrir"
                            type="object"
                            invisible="status != 'resolved'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,inProgress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Titre de l'intervention"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="type"/>
                            <field name="category_id"/>
                            <field name="priority"/>
                            <field name="mobile_activity_code"/>
                            <field name="activity_id"/>
                            <field name="mobile_asset_code"/>
                            <field name="asset_id"/>
                        </group>
                        <group string="Planification">
                            <field name="date_due"/>
                            <field name="date_completed" readonly="1"/>
                            <field name="team_id"/>
                            <field name="staff_id"/>
                            <field name="assigned_to" invisible="staff_id"/>
                            <field name="mobile_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description détaillée..."/>
                        </page>
                        <page string="Travail réalisé" name="work">
                            <group>
                                <group>
                                    <field name="duration" widget="float_time"/>
                                    <field name="cost"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="recurrence_days"/>
                                </group>
                            </group>
                            <field name="service_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="asset_id"/>
                                    <field name="service_type"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_club_intervention_search" model="ir.ui.view">
        <field name="name">amarna.club.intervention.search</field>
        <field name="model">amarna.club.intervention</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="mobile_id"/>
                <field name="activity_id"/>
                <field name="staff_id"/>
                <field name="asset_id"/>
                <field name="category_id"/>
                <filter string="Mes interventions" name="filter_mine"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="Incidents" name="filter_anomaly"
                        domain="[('type', '=', 'anomaly')]"/>
                <filter string="Maintenance" name="filter_maintenance"
                        domain="[('type', 'in', ('preventive', 'corrective'))]"/>
                <separator/>
                <filter string="Ouvertes" name="filter_open"
                        domain="[('status', '=', 'open')]"/>
                <filter string="En cours" name="filter_in_progress"
                        domain="[('status', '=', 'inProgress')]"/>
                <filter string="Résolues" name="filter_resolved"
                        domain="[('status', '=', 'resolved')]"/>
                <separator/>
                <filter string="En retard" name="filter_overdue"
                        domain="[('date_due', '&lt;', context_today().strftime('%Y-%m-%d')), ('status', '!=', 'resolved')]"/>
                <group>
                    <filter string="Activité" name="group_activity"
                            context="{'group_by': 'activity_id'}"/>
                    <filter string="Statut" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Priorité" name="group_priority"
                            context="{'group_by': 'priority'}"/>
                    <filter string="Catégorie" name="group_category"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Technicien" name="group_staff"
                            context="{'group_by': 'staff_id'}"/>
                    <filter string="Équipe" name="group_team"
                            context="{'group_by': 'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_club_intervention_kanban" model="ir.ui.view">
        <field name="name">amarna.club.intervention.kanban</field>
        <field name="model">amarna.club.intervention</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" quick_create="false">
                <field name="priority"/>
                <field name="activity_id"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="activity_id" class="text-muted"/>
                        <div class="d-flex gap-1 flex-wrap">
                            <span t-if="record.priority.raw_value == 'critical'"
                                  class="badge text-bg-danger">Critique</span>
                            <span t-elif="record.priority.raw_value == 'high'"
                                  class="badge text-bg-warning">Élevé</span>
                            <span t-if="record.is_overdue.raw_value"
                                  class="badge text-bg-danger">En retard</span>
                        </div>
                        <footer class="pt-1">
                            <field name="date_due" widget="remaining_days" class="text-muted"/>
                            <field name="staff_id" class="ms-auto text-muted"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_club_interventions" model="ir.actions.act_window">
        <field name="name">Interventions</field>
        <field name="res_model">amarna.club.intervention</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune intervention</p>
            <p>Les incidents et maintenances créés depuis la tablette
               Amarna Club apparaissent ici.</p>
        </field>
    </record>

    <record id="action_club_incidents" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">amarna.club.intervention</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'anomaly')]</field>
        <field name="context">{'default_type': 'anomaly'}</field>
    </record>

    <record id="action_club_preventive" model="ir.actions.act_window">
        <field name="name">Maintenance préventive</field>
        <field name="res_model">amarna.club.intervention</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'preventive')]</field>
        <field name="context">{'default_type': 'preventive'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun entretien préventif planifié</p>
            <p>Donnez un intervalle d'entretien à vos équipements : un ticket est créé automatiquement avant l'échéance.</p>
        </field>
    </record>

    <!-- Configuration screens -->
    <record id="view_club_intervention_category_tree" model="ir.ui.view">
        <field name="name">amarna.club.intervention.category.tree</field>
        <field name="model">amarna.club.intervention.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="staff_id"/>
            </list>
        </field>
    </record>

    <record id="action_club_intervention_category" model="ir.actions.act_window">
        <field name="name">Catégories de panne</field>
        <field name="res_model">amarna.club.intervention.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_club_intervention_team_tree" model="ir.ui.view">
        <field name="name">amarna.club.intervention.team.tree</field>
        <field name="model">amarna.club.intervention.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="staff_ids" widget="many2many_tags"/>
                <field name="ticket_count"/>
            </list>
        </field>
    </record>

    <record id="view_club_intervention_team_form" model="ir.ui.view">
        <field name="name">amarna.club.intervention.team.form</field>
        <field name="model">amarna.club.intervention.team</field>
        <field name="arch" type="xml">
            <form string="Équipe de maintenance">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ex. Équipe technique"/></h1></div>
                    <group><field name="staff_ids" widget="many2many_tags"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_club_intervention_team" model="ir.actions.act_window">
        <field name="name">Équipes de maintenance</field>
        <field name="res_model">amarna.club.intervention.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Equipment form: tickets of the equipment -->
    <record id="view_club_asset_form_interventions" model="ir.ui.view">
        <field name="name">amarna.club.asset.form.interventions</field>
        <field name="model">amarna.club.asset</field>
        <field name="inherit_id" ref="amarna_club_assets.view_club_asset_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_interventions" type="object" class="oe_stat_button"
                        icon="fa-ticket">
                    <field name="open_intervention_count" widget="statinfo" string="Interventions ouvertes"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Settings -->
    <record id="res_config_settings_view_form_amarna_interventions" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.amarna_club_interventions</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="64"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Maintenance" string="Maintenance" name="amarna_club_interventions">
                    <block title="Entretien préventif" name="amarna_preventive_block">
                        <setting id="amarna_preventive_lead"
                                 string="Préavis des tickets préventifs"
                                 help="Un ticket est créé automatiquement ce nombre de jours avant la prochaine maintenance d'un équipement.">
                            <field name="amarna_preventive_lead_days" class="oe_inline"/> jours
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="ir_cron_preventive_tickets" model="ir.cron">
        <field name="name">Maintenance : créer les tickets préventifs</field>
        <field name="model_id" ref="amarna_club_assets.model_amarna_club_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_preventive_tickets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <!-- Menus : app « Maintenance » -->
    <menuitem id="menu_club_interventions_root" web_icon="amarna_club_interventions,static/description/icon.svg"
              name="Maintenance"
              groups="abonnement_amarna.group_club_user"
              sequence="40"/>

    <menuitem id="menu_club_interventions_tickets" name="Interventions"
              parent="menu_club_interventions_root" sequence="10"/>
    <menuitem id="menu_club_interventions" name="Toutes les interventions"
              parent="menu_club_interventions_tickets" action="action_club_interventions" sequence="10"/>
    <menuitem id="menu_club_incidents" name="Incidents"
              parent="menu_club_interventions_tickets" action="action_club_incidents" sequence="20"/>
    <menuitem id="menu_club_preventive" name="Maintenance préventive"
              parent="menu_club_interventions_tickets" action="action_club_preventive" sequence="30"/>

    <menuitem id="menu_club_interventions_config" name="Configuration"
              parent="menu_club_interventions_root" sequence="90"
              groups="abonnement_amarna.group_club_manager"/>
    <menuitem id="menu_club_intervention_category" name="Catégories de panne"
              parent="menu_club_interventions_config" action="action_club_intervention_category" sequence="10"/>
    <menuitem id="menu_club_intervention_team" name="Équipes"
              parent="menu_club_interventions_config" action="action_club_intervention_team" sequence="20"/>

</odoo>
