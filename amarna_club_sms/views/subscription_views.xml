<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amarna_subscription_form_sms" model="ir.ui.view">
        <field name="name">amarna.subscription.form.sms</field>
        <field name="model">amarna.subscription</field>
        <field name="inherit_id" ref="abonnement_amarna.view_amarna_subscription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_renew']" position="after">
                <button name="action_send_expiry_sms" string="SMS de rappel" type="object"
                        invisible="state != 'confirmed'"
                        confirm="Envoyer maintenant le SMS de fin d'abonnement à ce membre ?"/>
            </xpath>
        </field>
    </record>

</odoo>
