<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Chaque matin à 9h (heure d'Alger) : 08:00 UTC. Sans effet tant que l'option n'est pas activée. -->
    <record id="ir_cron_expiry_sms" model="ir.cron">
        <field name="name">SMS de fin d'abonnement</field>
        <field name="model_id" ref="abonnement_amarna.model_amarna_subscription"/>
        <field name="state">code</field>
        <field name="code">model.cron_expiry_sms()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"/>
        <field name="active">True</field>
    </record>
</odoo>
