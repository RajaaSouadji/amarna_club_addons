<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_asset_tree" model="ir.ui.view">
        <field name="name">amarna.club.asset.tree</field>
        <field name="model">amarna.club.asset</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'broken'"
                  decoration-warning="status == 'maintenance'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="activity_id"/>
                <field name="category"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'available'"
                       decoration-info="status == 'inUse'"
                       decoration-warning="status == 'maintenance'"
                       decoration-danger="status == 'broken'"/>
                <field name="next_maintenance"/>
                <field name="is_weapon" optional="hide"/>
                <field name="code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_club_asset_form" model="ir.ui.view">
        <field name="name">amarna.club.asset.form</field>
        <field name="model">amarna.club.asset</field>
        <field name="arch" type="xml">
            <form string="Équipement">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'équipement"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="serial_number"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="is_weapon"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Affectation &amp; état">
                            <field name="mobile_activity_code"/>
                            <field name="activity_id"/>
                            <field name="status"/>
                            <field name="in_use_since" invisible="not in_use_since"/>
                        </group>
                    </group>
                    <group>
                        <group string="Maintenance">
                            <field name="last_maintenance"/>
                            <field name="next_maintenance"/>
                        </group>
                        <group string="Divers">
                            <field name="image_url"/>
                            <field name="specs_json"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_club_asset_search" model="ir.ui.view">
        <field name="name">amarna.club.asset.search</field>
        <field name="model">amarna.club.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="activity_id"/>
                <filter string="Armes" name="filter_weapons"
                        domain="[('is_weapon', '=', True)]"/>
                <filter string="Hors-service" name="filter_broken"
                        domain="[('status', '=', 'broken')]"/>
                <filter string="En maintenance" name="filter_maintenance"
                        domain="[('status', '=', 'maintenance')]"/>
                <group>
                    <filter string="Activité" name="group_activity"
                            context="{'group_by': 'activity_id'}"/>
                    <filter string="Statut" name="group_status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_club_assets" model="ir.actions.act_window">
        <field name="name">Équipements</field>
        <field name="res_model">amarna.club.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_club_armory" model="ir.actions.act_window">
        <field name="name">Armurerie</field>
        <field name="res_model">amarna.club.asset</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_weapon', '=', True)]</field>
    </record>

    <!-- Root app: Équipements Club -->
    <menuitem id="menu_club_assets_root"
              name="Équipements Club"
              sequence="21"
              groups="abonnement_amarna.group_club_user"/>

    <menuitem id="menu_club_assets"
              name="Équipements"
              parent="menu_club_assets_root"
              action="action_club_assets"
              sequence="10"/>

    <menuitem id="menu_club_armory"
              name="Armurerie"
              parent="menu_club_assets_root"
              action="action_club_armory"
              sequence="20"/>

</odoo>
