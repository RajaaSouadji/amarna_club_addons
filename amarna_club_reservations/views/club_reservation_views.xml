<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_reservation_tree" model="ir.ui.view">
        <field name="name">amarna.club.reservation.tree</field>
        <field name="model">amarna.club.reservation</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'checkedin'" decoration-muted="status == 'cancelled'"
                  decoration-danger="billing_state in ('unpaid', 'partial', 'to_invoice') and status != 'cancelled'">
                <field name="start_at" string="Début" optional="hide"/>
                <field name="reservation_date"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="activity_id"/>
                <field name="partner_id"/>
                <field name="client_name" optional="hide"/>
                <field name="people_count"/>
                <field name="subscription_id" optional="hide"/>
                <field name="amount_total" sum="Total TTC"/>
                <field name="billing_state" widget="badge"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_club_reservation_form" model="ir.ui.view">
        <field name="name">amarna.club.reservation.form</field>
        <field name="model">amarna.club.reservation</field>
        <field name="arch" type="xml">
            <form string="Réservation">
                <header>
                    <button name="action_check_in" string="Arrivée (check-in)" type="object"
                            class="btn-primary"
                            invisible="status not in ('pending', 'confirmed')"/>
                    <button name="action_confirm" string="Confirmer" type="object"
                            invisible="status != 'pending'"/>
                    <button name="action_collect" string="Encaisser" type="object"
                            class="btn-primary"
                            invisible="status == 'cancelled' or billing_state not in ('to_invoice', 'unpaid', 'partial')"
                            help="Facture si besoin, puis ouvre l'encaissement (espèces, chèque, carte)."/>
                    <button name="action_create_invoice" string="Facturer sans encaisser" type="object"
                            invisible="status == 'cancelled' or billing_state != 'to_invoice'"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="status in ('cancelled', 'checkedin')"
                            confirm="Annuler cette réservation ?"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,confirmed,checkedin"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Factures"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id"/>
                            <field name="client_name"/>
                            <field name="subscription_id"/>
                            <field name="rfid_card_id" domain="[('partner_id', '=', partner_id)]"
                                   options="{'no_create': True}" placeholder="Carte du membre"/>
                            <field name="people_count"/>
                            <field name="notes"/>
                        </group>
                        <group string="Créneau">
                            <field name="activity_id"/>
                            <field name="mobile_activity_code" groups="base.group_no_one"/>
                            <field name="reservation_date"/>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="start_at" readonly="1"/>
                            <field name="end_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Facturation">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="billing_period_start" invisible="1"/>
                            <field name="payment_required"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_total"/>
                        </group>
                        <group>
                            <field name="amount_invoiced"/>
                            <field name="amount_paid"/>
                            <field name="amount_due" class="fw-bold"/>
                            <field name="billing_state" widget="badge"/>
                            <field name="payment_valid" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Factures" name="invoices">
                            <field name="invoice_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="amount_residual" sum="Reste"/>
                                    <field name="payment_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_club_reservation_calendar" model="ir.ui.view">
        <field name="name">amarna.club.reservation.calendar</field>
        <field name="model">amarna.club.reservation</field>
        <field name="arch" type="xml">
            <calendar date_start="start_at" date_stop="end_at" color="activity_id" mode="day">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="activity_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_club_reservation_search" model="ir.ui.view">
        <field name="name">amarna.club.reservation.search</field>
        <field name="model">amarna.club.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="client_name"/>
                <field name="activity_id"/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('reservation_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="À venir" name="upcoming"
                        domain="[('reservation_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('status', '!=', 'cancelled')]"/>
                <filter string="Hors annulées" name="not_cancelled" domain="[('status', '!=', 'cancelled')]"/>
                <filter string="Annulées" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="En attente" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Arrivées" name="checkedin" domain="[('status', '=', 'checkedin')]"/>
                <filter string="À encaisser" name="unpaid"
                        domain="[('billing_state', 'in', ('to_invoice', 'unpaid', 'partial')), ('status', '!=', 'cancelled')]"/>
                <group>
                    <filter string="Activité" name="group_activity" context="{'group_by': 'activity_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'reservation_date:day'}"/>
                    <filter string="Statut" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- One page for the bookings: the Planning (calendar / list / form). Its search
         offers "Aujourd'hui", "À venir", "Annulées"... so no second list is needed. -->
    <menuitem id="menu_club_reservations_root" web_icon="amarna_club_reservations,static/description/icon.svg" name="Réservations" sequence="20"/>
    <!-- Qui voit cette application (rôles). Command.set remplace les groupes d'une version précédente. -->
    <record id="menu_club_reservations_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.clear(), Command.link(ref('abonnement_amarna.group_club_reception')), Command.link(ref('abonnement_amarna.group_club_coach'))]"/>
    </record>


</odoo>
