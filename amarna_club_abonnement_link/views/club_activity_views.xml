<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_activity_form_link" model="ir.ui.view">
        <field name="name">amarna.club.activity.form.link</field>
        <field name="model">amarna.club.activity</field>
        <field name="inherit_id" ref="amarna_club_base.view_club_activity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Abonnements">
                    <field name="subscription_activity_id"/>
                    <field name="subscription_plan_count"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
